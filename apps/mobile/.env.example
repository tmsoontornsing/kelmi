# The app holds no Supabase or RevenueCat key. It talks to the project's gateway function, which adds the anon key on the
# server (see docs/backend-gateway.md). Only the gateway's address goes here, and it is not a secret.
EXPO_PUBLIC_GATEWAY_URL=https://your-project-ref.supabase.co/functions/v1/gateway

# Native Google sign-in (Google Cloud > Credentials). Client IDs identify the app to Google and have to be in the app.
# The web client ID is the one Supabase's Google provider uses.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# RevenueCat's SDK keys are not set here. They are Supabase secrets (REVENUECAT_IOS_KEY, REVENUECAT_ANDROID_KEY) that the
# app-config function hands to signed-in users.
