        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.logicbaker.kelmi",
      "adaptiveIcon": {
        "backgroundColor": "#3DAA84",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true,
          "backgroundColor": "#3DAA84"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": false,
          "remindersPermission": "Kelmi adds your grocery list to a Reminders list so you can check items off while you shop. Kelmi only adds items to its own list."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#3DAA84"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.48779070634-d26dft747au9sjbual8opb14v078jflp"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.logicbaker.kelmi.widgets",
          "groupIdentifier": "group.com.logicbaker.kelmi",
          "enableAndroid": false,
          "widgets": [
            {
              "name": "KelmiToday",
              "displayName": "Today’s Meals",
              "description": "Breakfast, lunch, dinner, and your grocery progress.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "widgets/KelmiToday.tsx"
              },
              "android": null
            },
            {
              "name": "KelmiGroceries",
              "displayName": "Grocery List",
              "description": "What is left to buy, and how far along your shopping trip is.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "widgets/KelmiGroceries.tsx"
              },
              "android": null
            }
          ]
        }
      ],
      "expo-secure-store",
      "expo-localization"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.logicbaker.kelmi.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.logicbaker.kelmi"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "5d114b41-da03-4c56-b9c0-c3666c0be3aa"
      }
    },
    "owner": "logicbaker"
  }
}
