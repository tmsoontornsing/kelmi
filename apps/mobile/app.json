{
  "expo": {
    "name": "Kelmi",
    "slug": "kelmi",
    "scheme": "kelmi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
